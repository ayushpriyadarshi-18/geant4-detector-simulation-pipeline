# ============================================================
# Reference macro: soccerball_cs137_1M
# Geometry: soccerball / 4pi modular detector
# Material: BGO
# Source: Cs-137-like 662.0 keV mono gamma
# Events: 1000000
# ============================================================

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Detector setup
/det/material BGO
/det/geometry soccerball

# Soccerball/plastic options
/geom/usePlastic false
/geom/plasticZ 0.000 mm
/src/usePlastic false
/src/depth 1.000 mm

# Source at centre
/src/manualZ 0.000 mm

# Initialize
/run/initialize

# Source setup
/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre 0 0 0.000 mm
/gps/ang/type iso
/gps/ene/type Mono
/gps/ene/mono 662.0 keV

# Output
/analysis/setFileName events

# Run
/run/beamOn 1000000
